# Copy this file to .env and fill in real values.
# .env is gitignored — never commit real secrets.

# ── PostgreSQL ────────────────────────────────────────────────────────────────
# Superuser credentials — used by Flyway to run DDL migrations.
DB_SUPERUSER_USERNAME=postgres
DB_SUPERUSER_PASSWORD=change_me_superuser

# Application role — used by Spring Boot for all runtime queries.
# Lower-privilege than the superuser; only DML access.
DB_USERNAME=expense_app
DB_APP_PASSWORD=change_me_app

# Setup role — used by the dedicated Hikari pool that handles register,
# login, and default user setup. Separate from DB_APP_PASSWORD so the
# two roles cannot escalate into each other. See ADR-0011.
DB_SETUP_PASSWORD=change_me_setup

# JDBC connection URL. Points to the docker-compose db service by default.
DB_URL=jdbc:postgresql://localhost:5432/expense_db

# ── JWT ───────────────────────────────────────────────────────────────────────
# Signing secret for HS256. Must be at least 32 characters.
# Generate with: openssl rand -hex 32
JWT_SECRET=change_me_at_least_32_chars_long_xxxxxxxxxx
